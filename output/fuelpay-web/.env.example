# Copy to .env.local (gitignored). Never commit a real key.

# Where the API lives. Default '/v1' goes through the Vite proxy, which keeps
# dev same-origin. Set an absolute URL to talk to a deployed API directly,
# in which case that API's FUELPAY_CORS_ALLOW_ORIGINS must list this origin.
VITE_API_BASE_URL=/v1

# Host the Vite proxy forwards to.
VITE_PROXY_TARGET=http://localhost:8000

# Pre-fills the key gate. The service seeds this key on first boot.
VITE_FUELPAY_API_KEY=dev-local-key-change-me

# Netpoc corporate site origin (no trailing slash), e.g. https://netpoc.com.
# Powers the "No code yet? Book a PoC with Netpoc" links on the sign-in and
# demo screens. Leave unset and those links are hidden.
VITE_NETPOC_URL=
