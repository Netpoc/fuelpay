# Copy to .env and adjust. Compose reads this file.

POSTGRES_USER=fuelpay
POSTGRES_PASSWORD=fuelpay
POSTGRES_DB=fuelpay
POSTGRES_PORT=5432
API_PORT=8000

# Overridden inside compose to point at the `db` service host.
FUELPAY_DATABASE_URL=postgresql+asyncpg://fuelpay:fuelpay@localhost:5432/fuelpay

# Browser origins allowed to call the API. Comma-separated, or * for any.
# The Vite dev server defaults to 5173.
FUELPAY_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FUELPAY_CORS_ALLOW_CREDENTIALS=false

# Live ticking simulator
FUELPAY_SIM_ENABLED=true
FUELPAY_SIM_TICK_SECONDS=300
# Simulated minutes advanced per real tick. 5 = realtime at a 300s tick.
#
# The simulated clock is locked to wall-clock: a tick advances to `now` and
# then stops, so shortening SIM_TICK_SECONDS does not produce data faster. What
# governs the rate of new readings is MINUTES_PER_TICK -- one reading per that
# many *real* minutes. For a livelier demo use 1 and 15:
#   FUELPAY_SIM_MINUTES_PER_TICK=1
#   FUELPAY_SIM_TICK_SECONDS=15
FUELPAY_SIM_MINUTES_PER_TICK=5

# Deterministic simulation. Same seed + same fleet => same data.
FUELPAY_SIM_SEED=20260729

# --- incident rates ---
# Defaults are the researched real-world figures. To make siphons frequent
# enough to watch, raise the probability AND open the window -- leaving it at
# 22:00-04:00 means a midday demo still sees nothing however high the odds.
#   FUELPAY_SIM_THEFT_PROBABILITY_PER_DAY=20
#   FUELPAY_SIM_THEFT_WINDOW_START_HOUR=0
#   FUELPAY_SIM_THEFT_WINDOW_END_HOUR=24
# Or drive incidents explicitly via POST /v1/admin/simulate/{drain,refill,level}.
FUELPAY_SIM_THEFT_PROBABILITY_PER_DAY=0.015
FUELPAY_SIM_THEFT_VOLUME_MIN_FRACTION=0.20
FUELPAY_SIM_THEFT_VOLUME_MAX_FRACTION=0.40
FUELPAY_SIM_THEFT_WINDOW_START_HOUR=22
FUELPAY_SIM_THEFT_WINDOW_END_HOUR=4
FUELPAY_SIM_REFILL_WINDOW_START_HOUR=8
FUELPAY_SIM_REFILL_WINDOW_END_HOUR=17

# --- demo fleet ---
# Days of history generated behind `now` on the first boot against an empty
# database. 60 days x 12 generators at 5-minute resolution is ~207k readings.
FUELPAY_SEED_BACKFILL_DAYS=60

# Bootstrap API key issued to the seed organisation on first migration.
FUELPAY_BOOTSTRAP_API_KEY=dev-local-key-change-me

# Outbound event webhook (leave blank to disable)
FUELPAY_WEBHOOK_URL=
FUELPAY_WEBHOOK_TIMEOUT_SECONDS=5

# Operator key for /v1/platform (create PoC coupons, list/purge demo tenants).
# Leave empty to disable the platform API.
FUELPAY_PLATFORM_ADMIN_KEY=

# Coupon-gated demo accounts
FUELPAY_DEMO_BACKFILL_DAYS=30
FUELPAY_DEMO_BACKFILL_CONCURRENCY=2
FUELPAY_DEMO_PURGE_GRACE_HOURS=24
FUELPAY_DEMO_REDEEM_PER_MINUTE=5
